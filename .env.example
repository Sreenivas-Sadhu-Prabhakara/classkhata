# ClassKhata runs 100% offline by default — every value below is optional.

# HTTP port (defaults to 8105).
PORT=8105

# WhatsApp provider mode.
#   mock (default) — deterministic, zero keys; messages land in the Outbox
#                    with FNV-derived wamid.MOCK-XXXXXXXX ids.
#   live           — would call the WhatsApp Business Cloud API using the
#                    credentials below. The MVP ships only the mock and logs
#                    a notice if "live" is requested.
WHATSAPP_PROVIDER=mock
#WHATSAPP_TOKEN=
#WHATSAPP_PHONE_NUMBER_ID=
